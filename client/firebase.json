{
  "hosting": {
    "public": "out",
    "redirects": [
      {
        "source": "/admin",
        "destination": "/admin.html",
        "type": 301
      },
      {
        "source": "/admin/",
        "destination": "/admin.html",
        "type": 301
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
